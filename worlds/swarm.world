<?xml version="1.0"?>
<sdf version="1.5">
  <world name="default">
      <!-- Physics retains the supplied settings: 500 Hz, 0.002 s, 30 iterations.
    An A/B trial on 2026-08-01 compared bumblebee's 1000 Hz, 0.001 s,
    100-iteration setting. Camera frame timing was unchanged: median 33.3 ms
    and standard deviation about 6 ms at 30 Hz. gzserver CPU increased from
    64% to 115%. Camera freezing came from update_rate=5, subsequently
    raised to 30, rather than from the physics settings. -->
    <physics type="ode">
      <ode>
        <solver>
          <type>quick</type>
          <iters>30</iters>
          <sor>1.0</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>0.1</contact_max_correcting_vel>
          <contact_surface_layer>0.0</contact_surface_layer>
        </constraints>
      </ode>
      <real_time_update_rate>500</real_time_update_rate>
      <max_step_size>0.002</max_step_size>
    </physics>

    <scene>
      <shadows>false</shadows>
      <ambient>0.4 0.4 0.4 1</ambient>
      <!-- The background is SKY BLUE. The previous 0.25 was grey: because the <sky> dome was only rendered as a band near the horizon on the sensor cameras, the upper ~%75 of the frame of the camera looking up 30 degrees appeared VILLAGE GRAY (measured: BGR 18,18,18). It did not disrupt target detection, but the image looked like the "camera was broken" and was unrealistic. -->
      <background>0.55 0.72 0.92 1</background>
    </scene>


    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>5000 5000</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1</mu>
                <mu2>1</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="runway">
          <pose>000 0 0.005 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1829 45</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Runway</name>
            </script>
          </material>
        </visual>

        <visual name="grass">
          <pose>0 0 -0.1 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>5000 5000</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grass</name>
            </script>
          </material>
        </visual>

      </link>
    </model>

    <include>
      <uri>model://sun</uri>
    </include>

    <model name="iris-1">
      <include>
        <uri>model://swarm_drone_1</uri>
      </include>
      <pose> 0 0 0 0 0 0</pose>
    </model>

    <model name="iris-2">
      <include>
        <uri>model://swarm_drone_2</uri>
      </include>
      <pose> 2.5 0 0 0 0 0</pose>
    </model>

    <model name="iris-3">
      <include>
        <uri>model://swarm_drone_3</uri>
      </include>
      <pose> 5 0 0 0 0 0</pose>
    </model>

    <model name="iris-4">
      <include>
        <uri>model://swarm_drone_4</uri>
      </include>
      <pose> 7.5 0 0 0 0 0</pose>
    </model>

    <model name="iris-5">
      <include>
        <uri>model://swarm_drone_5</uri>
      </include>
      <pose> 10 0 0 0 0 0</pose>
    </model>

    <model name="target_value">
      <include>
        <uri>model://gazebo-plane6</uri>
      </include>
      <pose> 20 0 0 0 0 0</pose>
    </model>

  </world>
</sdf>

